# Line-ending policy. The repo is stored LF; Windows editors otherwise
# re-introduce CRLF into individual lines, which mixes endings inside one
# file and fails `git diff --check`.
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.pro text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Windows batch scripts must keep their stored bytes untouched.
*.bat -text
*.cmd -text
